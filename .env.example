# =============================================================================
# Vantage — copy to .env and fill in. NEVER commit the real .env.
# =============================================================================

# ---------- Core -------------------------------------------------------------
# ENVIRONMENT: development | production. With "production" the API refuses to
# start on development secrets or with COOKIE_SECURE=false.
ENVIRONMENT=development
NODE_ENV=development
# One of: DEMO | PAPER | LIVE   (engine refuses to start on anything else)
TRADING_MODE=PAPER
# Master switch for real-money execution. Stays false until Phase 6 checks pass.
LIVE_TRADING_ENABLED=false
TZ=UTC

# ---------- Public URLs ------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------- PostgreSQL -------------------------------------------------------
# POSTGRES_* configure the container. DATABASE_URL is what the apps read.
POSTGRES_USER=vantage
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=vantage
DATABASE_URL=postgresql+asyncpg://vantage:change-me-postgres@postgres:5432/vantage

# ---------- Redis ------------------------------------------------------------
# REDIS_URL is what the apps read; add :<password>@ if you enable auth.
REDIS_URL=redis://redis:6379/0

# ---------- API security -----------------------------------------------------
# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be >= 32 chars; the development default is rejected on startup.
JWT_SECRET=replace-me-with-at-least-32-random-characters
# Peppers the refresh-token digest. Changing it invalidates every session.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
REFRESH_PEPPER=replace-me-with-a-separate-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30

# Must be true behind HTTPS in production or the refresh cookie is sent in clear.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Comma-separated or a JSON array. Both are accepted.
CORS_ORIGINS=http://localhost:3000

# ---------- Credential encryption (envelope) ---------------------------------
# 32-byte key, base64. NEVER rotate without a re-wrap migration.
CREDENTIAL_MASTER_KEY=replace-me-with-base64-32-byte-key
CREDENTIAL_KEY_VERSION=v1

# ---------- Email ------------------------------------------------------------
# There is no mailer yet. Auth emails are not sent at all; if you add one, these
# are the names to wire up.

# ---------- Rate limiting ----------------------------------------------------
# Rate limits are enforced but currently hardcoded per route in the routers
# (auth-login 10/min, auth-register 5/hour, backtest-submit 10/5min, ...).
# There is NO account lockout: a wrong password is throttled per IP only.

# ---------- MetaApi (MT5 cloud bridge) --------------------------------------
# https://app.metaapi.cloud  — use the sandbox token while developing.
METAAPI_ENABLED=false
# REQUIRED to connect a real MT4/MT5 account. Without it the broker
# "Test connection" endpoint returns 503 and no real account can be synced.
# Create an access token at https://app.metaapi.cloud (copy the token value).
METAAPI_TOKEN=
# Use the sandbox host for paper/demo, app.metaapi.cloud for production.
METAAPI_API_URL=https://sandbox.app.metaapi.cloud
METAAPI_REGION=eu-central-1

# ---------- Engine -----------------------------------------------------------
ENGINE_TICK_SECONDS=1
RECONCILE_INTERVAL_SECONDS=30
MARKET_DATA_STALE_SECONDS=15
